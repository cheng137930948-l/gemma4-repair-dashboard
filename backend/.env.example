# 复制本文件为 .env 后填入你自己的 Key（.env 已被 .gitignore 忽略，不会上传）
# 在 Google AI Studio 申请：https://aistudio.google.com/apikey
GOOGLE_API_KEY=在这里填入你的_API_KEY

# Gemma 4 模型 ID
#   gemma-4-26b-a4b-it  稳定、响应快（推荐，默认）
#   gemma-4-31b-it      质量略高，但近期接口偶发 500/504，演示不稳定
MODEL_NAME=gemma-4-26b-a4b-it

# 后端监听端口（默认 8001）。很多机器 8000 已被其它本地服务占用，故用 8001；
# 须与前端 gemma_config.js 的 backendBaseUrl 端口一致。
PORT=8001

# 单次 generate_content 的硬超时（毫秒）。取数轮通常 5–20s，但末轮“生成最终长报告”
# 明显更慢，30s 容易超时失败；这里给到 120s，让长报告也能稳定完成。
CALL_TIMEOUT_MS=120000

# 函数调用循环的总时长预算（秒）。超过后用已取到的数据强制收尾。
# 给到 150s，保证模型有足够轮次取数（WIP/不良/出勤…）再出结论。
RUN_BUDGET_SEC=150

# 录制回放模式（默认 0=关闭）。
#   先用 `python warm_cache.py` 预热三看板的真实跑批缓存，
#   再把 REPLAY_ONLY 设为 1 并重启后端，前端点「开始分析」会秒回缓存里的
#   真实 Gemma 4 结果（报告 / trace / 运行日志都是真的），录制零等待。
#   录制结束改回 0 即恢复实时调用。
REPLAY_ONLY=0
